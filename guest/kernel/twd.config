# twd's additions to Firecracker's CI guest config (both arches), applied by
# guest/build-kernel.sh; every line must survive `make olddefconfig`.
#
# Container mode (ADR-032 D3): the image is a read-only erofs (plain or
# LZ4-compressed, mkfs.erofs -zlz4), and the instance's scratch
# ext4 is the overlay upper.
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_XATTR=y
CONFIG_EROFS_FS_POSIX_ACL=y
CONFIG_EROFS_FS_SECURITY=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_OVERLAY_FS=y
# Already in the Firecracker CI config; pinned here because container mode
# needs them (pids.max in the guest, exec PTYs, the exec stdio vsock streams).
CONFIG_CGROUP_PIDS=y
CONFIG_UNIX98_PTYS=y
CONFIG_VIRTIO_VSOCKETS=y
# Reproducible: no build-time salt from the original (Amazon Linux) tree.
CONFIG_BUILD_SALT="twd-guest"
CONFIG_LOCALVERSION="-twd"
# CONFIG_LOCALVERSION_AUTO is not set
