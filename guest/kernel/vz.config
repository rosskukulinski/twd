# twd guest kernel for the macOS (Virtualization.framework) backend: options
# added to Firecracker's CI config (guest/build-kernel.sh).
# virtiofs: the Rosetta for Linux directory share (and later shares).
CONFIG_FUSE_FS=y
CONFIG_VIRTIO_FS=y
# Container images are flattened to erofs (ADR-032 D3), with an overlay upper.
CONFIG_EROFS_FS=y
CONFIG_OVERLAY_FS=y
# Rosetta is registered with binfmt_misc by twd-guestd.
CONFIG_BINFMT_MISC=y
# vz devices: virtio-pci, its console (hvc0), vsock, entropy.
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_VSOCKETS=y
CONFIG_HW_RANDOM_VIRTIO=y
