{
  "name": "cfagents",
  "tailnet": {
    "tags": ["tag:ttest"],
    "objects": {
      // facet mode (default): per-object egress from the agent's own node
      "StateAgent": { "tags": ["tag:ttest"], "agent": true },
      // plain-DO mode: alarms (schedule/scheduleEvery) work; egress = workload node
      "PlainAgent": { "tags": ["tag:ttest"], "agent": true, "egress": "workload" }
    }
  }
}
