{
  "name": "agent",
  "tailnet": {
    "tags": ["tag:twd-wl-agent"],
    "objects": {
      // each instance gets its own node; egress leaves from it (facet mode)
      "SupportAgent": { "tags": ["tag:twd-agent-support"], "agent": true },
      "LookupAgent":  { "tags": ["tag:twd-agent-support-sub"], "agent": true, "ttl": "10m" }
      // a class that needs alarms (Agents SDK schedule()) uses plain-DO mode:
      //   "Reminder": { "tags": [...], "egress": "workload" }
    },
    "spawn": { "maxLive": 64, "maxDepth": 3 }
  }
}
