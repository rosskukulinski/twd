{
  "name": "ai-agent",
  "tailnet": {
    "tags": ["tag:twd-wl-ai"],
    "objects": {
      // one agent per caller; each is its own node, so the MCP server
      // authorizes (and audits) the agent itself, not the whole app
      "AiAgent": { "tags": ["tag:twd-ai-agent"], "agent": true }
    },
    // the MCP server(s) the agent's tools call
    "connects": ["tag:twd-wl-mcp"]
  }
  // policy: grant the agent the tools it may call, e.g.
  //   { "src": ["tag:twd-ai-agent"], "dst": ["tag:twd-wl-mcp"], "ip": ["tcp:80"],
  //     "app": { "example.com/cap/mcp": [{ "tools": ["lookup_order"] }] } }
}
